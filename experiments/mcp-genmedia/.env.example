# Environment Configuration Template for MCP Genmedia + Gemini CLI
# Copy this file to .env and fill in your actual values

# =============================================================================
# GOOGLE CLOUD CONFIGURATION (Required)
# =============================================================================

# Your Google Cloud Project ID
PROJECT_ID=your-project-id

# Google Cloud region for deployment
LOCATION=us-central1

# Google Cloud zone (optional, defaults to us-central1-a)
ZONE=us-central1-a

# Storage bucket for generated media files
# Will be created if it doesn't exist
GENMEDIA_BUCKET=your-project-id-genmedia

# =============================================================================
# API KEYS (Optional)
# =============================================================================

# Brave Search API Key for web search capabilities
# Get your API key from: https://api.search.brave.com/
BRAVE_API_KEY=

# OpenAI API Key (if using OpenAI models alongside Gemini)
OPENAI_API_KEY=

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=development

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# Enable development features
DEBUG=true

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# Path to MCP configuration file
MCP_CONFIG_PATH=~/.config/mcp/config.json

# MCP server timeout (seconds)
MCP_TIMEOUT=30

# Enable MCP debugging
MCP_DEBUG=true

# =============================================================================
# GEMINI CLI CONFIGURATION
# =============================================================================

# Default Gemini model to use
GEMINI_MODEL=gemini-1.5-pro

# Gemini generation temperature (0.0 to 1.0)
GEMINI_TEMPERATURE=0.7

# Maximum output tokens
GEMINI_MAX_OUTPUT_TOKENS=8192

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health check port
HEALTH_PORT=8080

# Health check interval (seconds)
HEALTH_INTERVAL=30

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Local cache directory for development
CACHE_DIR=./cache

# Maximum file size for uploads (bytes)
MAX_FILE_SIZE=104857600

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov,avi,mp3,wav,pdf,txt,md

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Enable CORS in development
CORS_ENABLED=true

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Session secret (generate a random string for production)
SESSION_SECRET=your-session-secret-change-this

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================

# Redis configuration for caching/sessions
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL configuration for persistent storage
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5432/mcp_genmedia

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Enable application metrics
METRICS_ENABLED=true

# Metrics port
METRICS_PORT=9090

# Enable structured logging
STRUCTURED_LOGS=true

# =============================================================================
# CONTAINER CONFIGURATION
# =============================================================================

# Container port
PORT=8080

# Container user ID (for security)
USER_ID=1000

# Container group ID
GROUP_ID=1000

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# GitHub repository (for CI/CD)
GITHUB_REPO=your-org/vertex-ai-creative-studio

# Docker registry
DOCKER_REGISTRY=gcr.io

# Container image name
IMAGE_NAME=mcp-genmedia

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Enable rate limiting
RATE_LIMITING=true

# Enable request caching
REQUEST_CACHING=true

# Enable batch processing
BATCH_PROCESSING=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Connection pool size
CONNECTION_POOL_SIZE=10

# Worker threads
WORKER_THREADS=4

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable hot reloading in development
HOT_RELOAD=true

# Enable source maps
SOURCE_MAPS=true

# Enable profiling
PROFILING=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit this file with real values to version control
# 2. Use Google Cloud Secret Manager for production secrets
# 3. Ensure PROJECT_ID, LOCATION, and GENMEDIA_BUCKET are set for basic functionality
# 4. BRAVE_API_KEY is optional but enables web search capabilities
# 5. Database settings are optional - remove if not using persistent storage
# 6. Adjust resource limits based on your workload requirements
