{
  "name": "mcp-genmedia",
  "version": "1.0.0",
  "description": "MCP Genmedia + Gemini CLI integration for creative generative media workflows",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mcp:start": "./start-mcp-servers.sh",
    "mcp:test": "./test-mcp-connectivity.sh",
    "mcp:inspect": "mcp-inspector",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist node_modules/.cache",
    "docker:build": "docker build -f docker/Dockerfile.production -t mcp-genmedia .",
    "docker:run": "docker run -p 8080:8080 mcp-genmedia",
    "deploy:dev": "./start-dev.sh",
    "deploy:prod": "./deploy-production.sh",
    "setup": "./local-setup.sh"
  },
  "keywords": [
    "mcp",
    "gemini",
    "vertex-ai",
    "genmedia",
    "google-cloud",
    "ai",
    "generative-media",
    "imagen",
    "veo",
    "creative-ai"
  ],
  "author": "Vertex AI Creative Studio",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@google-cloud/aiplatform": "^3.15.0",
    "@google-cloud/storage": "^7.7.0",
    "google-auth-library": "^9.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "multer": "^1.4.5-lts.1",
    "mime-types": "^2.1.35",
    "sharp": "^0.32.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^0.4.0",
    "@modelcontextprotocol/server-memory": "^0.4.0",
    "@modelcontextprotocol/server-brave-search": "^0.4.0",
    "@modelcontextprotocol/inspector": "^0.4.0",
    "@types/node": "^20.9.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/mime-types": "^2.1.4",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.9",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "nodemon": "^3.0.1",
    "typescript": "^5.2.2",
    "supertest": "^6.3.3",
    "nock": "^13.4.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vertex-ai-creative-studio.git",
    "directory": "experiments/mcp-genmedia"
  },
  "bugs": {
    "url": "https://github.com/your-org/vertex-ai-creative-studio/issues"
  },
  "homepage": "https://github.com/your-org/vertex-ai-creative-studio/tree/main/experiments/mcp-genmedia#readme",
  "files": [
    "dist/",
    "bin/",
    "docker/",
    "deployment/",
    "*.md",
    "*.json",
    "*.sh"
  ],
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
